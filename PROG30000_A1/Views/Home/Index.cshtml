@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid py-4">

    <!-- Welcome Section -->
    <div class="bg-dark text-white rounded-3 p-5 mb-4 shadow-sm">
        <div class="row align-items-center">

            <div class="col-lg-9">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="bi bi-laptop me-3"></i>
                    FAST Equipment Tools
                </h1>

                <h3 class="fw-light mb-3">
                    Find It. Borrow It. Return It.
                </h3>

                <p class="lead text-white-50 mb-4">
                    Get quick access to the equipment you need
                    for your projects and coursework.
                    Browse available equipment and submit
                    borrowing requests with ease.
                </p>

                <a asp-controller="Request"
                   asp-action="RequestForm"
                   class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-clipboard-plus me-2"></i>
                    Request Equipment
                </a>
            </div>

            <div class="col-lg-3 text-center d-none d-lg-block">
                <i class="bi bi-pc-display"
                   style="font-size: 130px; color: #adb5bd;"></i>
            </div>

        </div>
    </div>

    <!-- How It Works -->
    <div class="bg-light rounded-3 p-4 mt-4 shadow-sm">

        <h2 class="fw-bold text-center mb-4">
            How It Works
        </h2>

        <div class="row g-4 text-center">

            <div class="col-md-4">
                <i class="bi bi-search text-primary"
                   style="font-size: 48px;"></i>

                <h4 class="mt-3">1. Browse</h4>

                <p class="text-muted">
                    Explore the equipment inventory
                    and check availability.
                </p>
            </div>

            <div class="col-md-4">
                <i class="bi bi-file-earmark-text text-primary"
                   style="font-size: 48px;"></i>

                <h4 class="mt-3">2. Request</h4>

                <p class="text-muted">
                    Complete the borrowing request form
                    with your information.
                </p>
            </div>

            <div class="col-md-4">
                <i class="bi bi-envelope-check text-success"
                   style="font-size: 48px;"></i>

                <h4 class="mt-3">3. Confirmation</h4>

                <p class="text-muted">
                    Receive confirmation of your submission.
                    The IT department will contact you soon.
                </p>
            </div>

        </div>
    </div>

</div>
